# Dockerfile.tests
FROM python:3.13-slim

# Prevent Python from writing .pyc files and buffer output
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /src

# Upgrade pip and install UV
RUN pip install --upgrade pip && pip install uv

# Copy all project files into the container
COPY . /src

# Create a virtual environment in /src/.venv so that UV can use it
RUN python -m venv .venv

# Install dependencies (with dev extras) using UV
RUN uv sync --all-extras --dev

# Copy the test entrypoint script and make it executable
COPY entrypoint_tests.sh /entrypoint_tests.sh
RUN chmod +x /entrypoint_tests.sh

# Use the test entrypoint script
ENTRYPOINT ["/entrypoint_tests.sh"]
